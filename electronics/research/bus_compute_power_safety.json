  {
   "name": "CAN FD (ISO 11898-1:2015)",
   "manufacturer": "ISO / CAN in Automation (CiA); originated by Bosch",
   "part_number": "ISO 11898-1:2015 (CAN FD)",
   "interface": "bus.protocol",
   "variant_note": "ISO CAN FD differs from the non-ISO 2012 Bosch whitepaper CAN FD (CRC/stuff-count change).",
   "specs": [
    {
     "field": "standard_identifier",
     "value": "ISO 11898-1:2015",
     "unit": null,
     "conditions": null,
     "source_id": "e_linux_can_doc",
     "quote": "ISO compliant:     The ISO 11898-1:2015 CAN FD implementation (default)",
     "verification": "fetched_secondary"
    },
    {
     "field": "max_payload_bytes",
     "value": 64,
     "unit": "byte",
     "conditions": null,
     "source_id": "e_linux_can_doc",
     "quote": "CAN FD capable CAN controllers support up to 64 bytes of\npayload",
     "verification": "fetched_secondary"
    },
    {
     "field": "max_payload_bytes",
     "value": 64,
     "unit": "byte",
     "conditions": null,
     "source_id": "e_bosch_canfd",
     "quote": "expand the number of data bytes per CAN frame from up to 8 to up to 64",
     "verification": "search_snippet"
    },
    {
     "field": "dual_bitrate",
     "value": "separate arbitration-phase and data-phase bitrates",
     "unit": null,
     "conditions": null,
     "source_id": "e_linux_can_doc",
     "quote": "support two different bitrates for the arbitration phase and the payload phase of the CAN FD frame",
     "verification": "fetched_secondary"
    },
    {
     "field": "nominal_bitrate_max_commonly_cited",
     "value": 1,
     "unit": "Mbit/s",
     "conditions": "Classical CAN / arbitration-phase limit as cited by Bosch; not a value from the ISO text",
     "source_id": "e_bosch_canfd",
     "quote": "overcome the Classical CAN's bit rate limitation to 1 Mbps",
     "verification": "search_snippet"
    },
    {
     "field": "transceiver_standard_data_bitrate_max",
     "value": 5,
     "unit": "Mbit/s",
     "conditions": "ISO 11898-2:2016 transceiver parameter classes, not ISO 11898-1",
     "source_id": "e_cia_esa_slides",
     "quote": "ISO 11898-2:2016 standard specifies the parameters for CAN transceivers supporting bit-rates up to 2 Mbit/s and up to 5 Mbit/s",
     "verification": "search_snippet"
    }
   ],
   "unresolved": [
    "ISO 11898-1:2015 text itself is paywalled and iso.org / can-cia.org were unreachable (DNS); no primary fetch.",
    "Maximum data-phase bitrate is not fixed by ISO 11898-1; secondary sources cite 8 Mbit/s (Microchip) and 10 Mbit/s (Sontheim) - not recorded."
   ]
  },
  {
   "name": "DYNAMIXEL Protocol 2.0",
   "manufacturer": "ROBOTIS",
   "part_number": "DYNAMIXEL Protocol 2.0",
   "interface": "bus.protocol",
   "variant_note": "Physical layer and baud rates are per servo model; values here are from the DYNAMIXEL X-series (XM430-W350-T/R) entries of the e-Manual source.",
   "specs": [
    {
     "field": "packet_header_bytes",
     "value": [
      "0xFF",
      "0xFF",
      "0xFD"
     ],
     "unit": null,
     "conditions": "followed by a Reserved byte 0x00",
     "source_id": "e_robotis_p2",
     "quote": "waits for the next header (0xff 0xff 0xfd) before continuing to process packets",
     "verification": "fetched_primary"
    },
    {
     "field": "reserved_byte",
     "value": "0x00",
     "unit": null,
     "conditions": null,
     "source_id": "e_robotis_p2",
     "quote": "|   0xFF   |   0xFF   |   0xFD   |   0x00   |    ID     |",
     "verification": "fetched_primary"
    },
    {
     "field": "crc_type",
     "value": "CRC-16 (IBM/ANSI), polynomial 0x8005",
     "unit": null,
     "conditions": null,
     "source_id": "e_robotis_crc",
     "quote": "CRC-16 (IBM/ANSI)\n  - Polynomial : x16 + x15 + x2 + 1 (polynomial representation : 0x8005)",
     "verification": "fetched_primary"
    },
    {
     "field": "crc_length_bits",
     "value": 16,
     "unit": "bit",
     "conditions": null,
     "source_id": "e_robotis_p2",
     "quote": "A 16bit checksum used to determine if the Packet has been damaged during communication.",
     "verification": "fetched_primary"
    },
    {
     "field": "byte_stuffing",
     "value": "0xFF 0xFF 0xFD -> 0xFF 0xFF 0xFD 0xFD",
     "unit": null,
     "conditions": null,
     "source_id": "e_robotis_p2",
     "quote": "byte stuffing adds 0xFD to the end of the pattern to convert it to \"0xFF 0xFF 0xFD 0xFD\"",
     "verification": "fetched_primary"
    },
    {
     "field": "physical_layers",
     "value": [
      "TTL half-duplex asynchronous serial",
      "RS-485 asynchronous serial"
     ],
     "unit": null,
     "conditions": "X-series (-T = TTL, -R = RS-485 variants); multidrop bus",
     "source_id": "e_robotis_xinfo",
     "quote": "TTL Half Duplex Asynchronous Serial Communication with 8bit, 1stop, No Parity<br />RS-485 Asynchronous Serial Communication with 8bit, 1stop, No Parity",
     "verification": "fetched_primary"
    },
    {
     "field": "supported_baud_rates",
     "value": [
      9600,
      57600,
      115200,
      1000000,
      2000000,
      3000000,
      4000000,
      4500000
     ],
     "unit": "bit/s",
     "conditions": "Default branch of the Baud Rate(8) table (applies to XM430 etc.); XL330/XC330/XM335 tables top out at 4M. Default 57,600 for X430.",
     "source_id": "e_robotis_baud",
     "quote": "|     7      |  4.5M [bps]   |    0.000 [%]    |",
     "verification": "fetched_primary"
    },
    {
     "field": "baud_rate_range",
     "value": "9,600 [bps] ~ 4.5 [Mbps]",
     "unit": null,
     "conditions": "X-series default spec value",
     "source_id": "e_robotis_xinfo",
     "quote": "baudrate:           &baudrate       \"9,600 [bps] ~ 4.5 [Mbps]\"",
     "verification": "fetched_primary"
    }
   ],
   "unresolved": [
    "emanual.robotis.com unreachable (DNS); values read from ROBOTIS's own e-Manual source repo on GitHub (raw.githubusercontent.com)."
   ]
