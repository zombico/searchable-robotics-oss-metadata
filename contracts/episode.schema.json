{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Minimal timed force-controlled jaw episode v0.2",
  "type": "object",
  "required": ["schema_version", "origin", "episode_id", "split", "leakage_group", "manifest", "transitions"],
  "properties": {
    "schema_version": {"const": "0.2.0"},
    "origin": {"enum": ["contract_fixture", "forward_simulation", "state_playback", "real_recording"]},
    "episode_id": {"type": "string", "minLength": 1},
    "split": {"enum": ["train", "validation", "test"]},
    "leakage_group": {"type": "string", "minLength": 1},
    "manifest": {
      "type": "object", "required": ["clock", "action_contract", "observation_contract", "asset_sha256", "engine", "seed"],
      "properties": {
        "clock": {"type": "object", "required": ["physics_dt_s", "control_decimation", "control_hz"], "properties": {"physics_dt_s": {"type": "number", "exclusiveMinimum": 0}, "control_decimation": {"type": "integer", "minimum": 1}, "control_hz": {"type": "number", "exclusiveMinimum": 0}}},
        "asset_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "seed": {"type": "integer"},
        "engine": {"type": "object", "required": ["name", "version", "runtime_scope"]},
        "action_contract": {"type": "object", "required": ["mode", "unit", "frame", "dimension", "hold", "controller_id", "lower", "upper"], "properties": {"mode": {"const": "joint_force"}, "unit": {"const": "N"}, "frame": {"const": "joint"}, "dimension": {"const": 1}, "hold": {"const": "zero_order"}}},
        "observation_contract": {"type": "object", "required": ["policy_channels", "privileged_channels"]}
      }
    },
    "transitions": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["t_s", "next_t_s", "action", "observation", "next_observation", "terminated", "truncated", "outcome"]}}
  },
  "description": "Minimal fixture contract; runtime validator checks causal timing and semantics. Other action spaces, cameras, depth, checkpoints and rewards are future extensions."
}
