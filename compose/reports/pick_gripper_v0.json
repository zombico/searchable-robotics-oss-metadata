        "SF": 1.5,
        "m_max_kg": 0.3,
        "g": 9.81,
        "a_lift_m_s2": 2.0,
        "mu_min": 0.3
      }
    },
    "jaw_drive_force_N": {
      "value": 17.715,
      "formula": "twin racks: total rack force = 2 * pad normal force"
    },
    "jaw_opening_m": {
      "value": 0.049999999999999996,
      "available": 0.060000000000000005,
      "formula": "w_max + 2 * 2.5 mm"
    },
    "per_jaw_travel_m": {
      "value": 0.025,
      "formula": "example.json jaw_travel_mm"
    },
    "max_close_time_s": {
      "value": 0.6,
      "formula": "proposed requirement"
    },
    "z_payload_N": {
      "value_without_servo": 10.3928,
      "limit": 30,
      "formula": "(carriage + gripper + servo + m_max) * (g + a_lift)"
    }
  },
