{
  "composer": "pick_gripper_v0",
  "scope": "Feasible means feasible in MuJoCo under the stated assumptions and catalog values. Release level: synthetic_only.",
  "assumptions": {
    "safety_factor": 1.5,
    "lift_accel_m_s2": 2.0,
    "rack_pinion_efficiency": 0.9,
    "pinion_module_mm": 1.0,
    "pinion_teeth_options": [
      12,
      20,
      30,
      40
    ],
    "min_teeth_without_profile_shift": 17,
    "max_full_stroke_close_s": 0.6,
    "rail_voltage_V": 12.0,
    "supply": "E72",
